# Astro Sales Forecasting MLOps Platform -- environment template.
#
#   cp .env.example .env
#
# Every value below has a working default in docker-compose.override.yml, with
# one exception: JWT_SECRET_KEY is required and has no fallback, so the API will
# not start until you set it. Override anything else only as you need to.
#
# Do not commit a filled-in .env. The credentials here are local development
# defaults and must be replaced for any shared or public deployment.

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Change these when another project already owns the port; nothing inside the
# Docker network is affected, only what the host publishes.
API_PORT=8010
FRONTEND_PORT=3001
# Fixed in compose (not templated): Streamlit 8501, MLflow 5001, MinIO API
# 9000, MinIO Console 9001, and Airflow 8080.

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The URL the BROWSER uses to reach the API, so it must be host-reachable --
# never a Docker service name. Must match API_PORT above.
NEXT_PUBLIC_API_URL=http://localhost:8010

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API. Must include the frontend's origin
# or every request fails preflight.
API_CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=INFO

# Model resolution. Registered model names are "<prefix><model>", which is how
# the training DAG registers them.
MLFLOW_REGISTERED_MODEL_PREFIX=sales_forecast_models_
FORECAST_MODELS=ensemble,xgboost,lightgbm
FORECAST_DEFAULT_MODEL=ensemble
# Refuse to serve a version that is not in the Production stage. Set to false
# only to test an unpromoted model; a forecast then says so in its warnings.
FORECAST_REQUIRE_PRODUCTION_STAGE=true

# Forecast bounds. The minimum exists because the models use windows up to 30
# days; below that the deepest features come from a partial window.
FORECAST_MIN_HISTORY_DAYS=30
FORECAST_MAX_HORIZON_DAYS=90
# Ratio used to rebuild `profit` from sales when a request does not supply it.
# 0.3 matches the M5 ingestion (profit = 0.3 * revenue). A request that
# includes profit overrides this with its own observed ratio.
FORECAST_PROFIT_TO_SALES_RATIO=0.3

# ---------------------------------------------------------------------------
# Authentication -- REQUIRED
# ---------------------------------------------------------------------------
# The API cannot sign or verify a token without this, and there is deliberately
# no generated fallback: one would invalidate every session on each restart and
# make two replicas reject each other's tokens.
#
#   echo "JWT_SECRET_KEY=$(openssl rand -base64 48)" >> .env
#
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=sales-forecasting-api
JWT_AUDIENCE=sales-forecasting
# The refresh cookie is HttpOnly, SameSite=Lax, and scoped to /auth. Set true
# behind HTTPS; false only for plain-HTTP local development, because a Secure
# cookie is dropped by the browser over http and sign-in then fails silently.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Open: new users create their own account at /register before signing in.
# They get BUSINESS_USER -- forecasts, exports, and scenarios, nothing that
# changes a model or a user. ADMIN and ML_ENGINEER are refused here. Set to
# false on a deployment where an administrator should create every account.
ALLOW_SELF_REGISTRATION=true
SELF_REGISTRATION_ROLE=BUSINESS_USER
# Roles the sign-up form offers; a new user picks one. ADMIN is excluded by
# default -- adding it lets any visitor manage every account, so do that only on
# a private demo.
SELF_REGISTRATION_ROLES=VIEWER,BUSINESS_USER,ANALYST,ML_ENGINEER
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# First-run bootstrap
# ---------------------------------------------------------------------------
# The first ADMIN is created only when the `users` table is empty. Leave the
# password unset and a strong one is generated and written to the API log once;
# sign in and change it immediately. There is no public "create first admin"
# endpoint to leave exposed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# Service account for the monitoring DAG. The API creates it at start-up and
# the Airflow scheduler signs in with it, so both must see the SAME value.
# Unset means no account is created and the DAG fails with a clear message
# rather than silently doing nothing. It gets ML_ENGINEER -- enough to evaluate
# monitoring and manage alerts, not enough to manage users.
MONITORING_SERVICE_EMAIL=monitoring-service@example.com
MONITORING_SERVICE_PASSWORD=
MONITORING_SERVICE_NAME=Monitoring Service

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
MONITORING_WINDOW_DAYS=28
MONITORING_SCHEDULE=@daily
MONITORING_ACTUALS_LOOKBACK_DAYS=14
MONITORING_ACTUALS_PATH=/usr/local/airflow/data/raw/kaggle_m5/v1.0.0/sales
# Where monitoring windows end: "today" for a live sales feed, "latest_actual"
# for a historical dataset such as M5 (outcomes end 2016-04-24), or an ISO date.
MONITORING_REFERENCE_DATE=latest_actual
# The internal URL the monitoring DAG calls. A Docker service name is correct
# here -- unlike NEXT_PUBLIC_API_URL, this one is never used by a browser.
MONITORING_API_URL=http://api:8000

# ---------------------------------------------------------------------------
# Training workspace (Monitoring > Data & Retraining)
# ---------------------------------------------------------------------------
# Uploaded training datasets are write-once objects in this MinIO bucket; the
# API writes them and the Airflow workers read them by service name.
TRAINING_DATASET_BUCKET=training-datasets
TRAINING_UPLOAD_MAX_BYTES=52428800
TRAINING_UPLOAD_MAX_ROWS=2000000
# reject | allow (allow keeps net-of-returns negative revenue, with a warning)
TRAINING_NEGATIVE_SALES_POLICY=reject
# Comma-separated store scope for training uploads; empty = any valid id.
TRAINING_ALLOWED_STORES=
TRAINING_ALLOWED_CURRENCIES=USD
# Airflow 3 REST API, called by the API only (never by the browser). With the
# Astro dev SimpleAuthManager every user is an admin; in a real deployment use
# a dedicated service account.
AIRFLOW_API_URL=http://api-server:8080
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=admin
# Browser link to a run, shown to ML engineers and admins.
AIRFLOW_PUBLIC_URL=http://localhost:19382
TRAINING_DAG_ID=sales_forecast_training

# ---------------------------------------------------------------------------
# Model registry links
# ---------------------------------------------------------------------------
# A browsable MLflow URL for the registry UI's run links. Distinct from
# MLFLOW_TRACKING_URI, which is an internal hostname a browser cannot resolve.
MLFLOW_PUBLIC_URL=http://localhost:5001

# ---------------------------------------------------------------------------
# Scenario Planner database
# ---------------------------------------------------------------------------
SCENARIO_DB_USER=scenario
SCENARIO_DB_PASSWORD=scenario
SCENARIO_DB_NAME=scenario
SCENARIO_ENABLED_TYPES=promotion,traffic,closure,holiday,price,snap,custom
BASELINE_REQUIRE_PRODUCTION_STAGE=true
BASELINE_RESIDUAL_HORIZON_SCALING=true
BASELINE_FORECAST_TTL_HOURS=24

# ---------------------------------------------------------------------------
# MinIO (artifact store)
# ---------------------------------------------------------------------------
# Local development credentials. Change them anywhere that is not your laptop.
# These reach the API and MLflow only; the browser never receives them.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------------------------------------------
# Airflow / training (optional)
# ---------------------------------------------------------------------------
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=120
# The port is published by both the plain-Compose profile and the Astro-managed
# stack, so the Airflow UI is consistently reachable at localhost:8080.
AIRFLOW_PORT=8080
AIRFLOW_DB_USER=postgres
AIRFLOW_DB_PASSWORD=postgres
AIRFLOW_DB_NAME=postgres
# Local-only defaults. Replace both anywhere the Airflow UI is reachable by
# anyone else -- that setup uses Airflow's SimpleAuthManager with every user an
# admin, exactly as the Astro CLI does locally.
AIRFLOW_SECRET_KEY=sales-forecasting-local
AIRFLOW_JWT_SECRET=sales-forecasting-local
# Empty means stored connection secrets are not encrypted. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Only needed to re-ingest the M5 dataset from Kaggle; training reuses the
# parquet cache in data/raw by default.
# KAGGLE_USERNAME=
# KAGGLE_API_TOKEN=
