# Astro Sales Forecasting MLOps Platform -- environment template.
#
#   cp .env.example .env
#
# Every value below has a working default in docker-compose.override.yml, so an
# empty .env still starts the stack. Override only what you need.
#
# Do not commit a filled-in .env. The credentials here are local development
# defaults and must be replaced for any shared or public deployment.

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Change these when another project already owns the port; nothing inside the
# Docker network is affected, only what the host publishes.
API_PORT=8000
FRONTEND_PORT=3000
# Fixed in compose (not templated): Streamlit 8501, Airflow 8080, MLflow 5001,
# MinIO API 9000, MinIO Console 9001.

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The URL the BROWSER uses to reach the API, so it must be host-reachable --
# never a Docker service name. Must match API_PORT above.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API. Must include the frontend's origin
# or every request fails preflight.
API_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Model resolution. Registered model names are "<prefix><model>", which is how
# the training DAG registers them.
MLFLOW_REGISTERED_MODEL_PREFIX=sales_forecast_models_
FORECAST_MODELS=ensemble,xgboost,lightgbm
FORECAST_DEFAULT_MODEL=ensemble
# Refuse to serve a version that is not in the Production stage. Set to false
# only to test an unpromoted model; a forecast then says so in its warnings.
FORECAST_REQUIRE_PRODUCTION_STAGE=true

# Forecast bounds. The minimum exists because the models use windows up to 30
# days; below that the deepest features come from a partial window.
FORECAST_MIN_HISTORY_DAYS=30
FORECAST_MAX_HORIZON_DAYS=90
# Ratio used to rebuild `profit` from sales when a request does not supply it.
# 0.3 matches the M5 ingestion (profit = 0.3 * revenue). A request that
# includes profit overrides this with its own observed ratio.
FORECAST_PROFIT_TO_SALES_RATIO=0.3

# ---------------------------------------------------------------------------
# Scenario Planner database
# ---------------------------------------------------------------------------
SCENARIO_DB_USER=scenario
SCENARIO_DB_PASSWORD=scenario
SCENARIO_DB_NAME=scenario
SCENARIO_ENABLED_TYPES=promotion,traffic,closure,holiday,price,custom
BASELINE_REQUIRE_PRODUCTION_STAGE=true
BASELINE_RESIDUAL_HORIZON_SCALING=true
BASELINE_FORECAST_TTL_HOURS=24

# ---------------------------------------------------------------------------
# MinIO (artifact store)
# ---------------------------------------------------------------------------
# Local development credentials. Change them anywhere that is not your laptop.
# These reach the API and MLflow only; the browser never receives them.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------------------------------------------------------------------------
# Airflow / training (optional)
# ---------------------------------------------------------------------------
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=120
# Only needed to re-ingest the M5 dataset from Kaggle; training reuses the
# parquet cache in data/raw by default.
# KAGGLE_USERNAME=
# KAGGLE_API_TOKEN=
